# 이 파일을 같은 폴더에 `.env` 라는 이름으로 복사한 뒤, 값 부분만 채웁니다.
# `.env` 파일 자체는 절대 공유하지 않습니다.

# 1일차에 강사가 개인별로 나눠 주는 키를 붙여넣습니다.
OPENAI_API_KEY=

# 8일차에 LangSmith 가입 후 추가합니다. 그 전에는 아래 두 줄을 지운 채로 둡니다.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true

# 7일차(멀티모달·이미지 파이프라인)에 GCP Vertex AI 서비스 계정 json을 받은 뒤 추가합니다. 그 전에는 아래 세 줄을 지운 채로 둡니다.
# GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_PROJECT=
# VERTEX_LOCATION=
